APP_NAME=AI Code Review Assistant
VERSION=1.0.0
DEBUG=False
FRONTEND_URL=http://localhost:5173
# Comma-separated browser origins. Set this to the Vercel production URL
# and any other trusted frontend URL that should call the API.
CORS_ORIGINS=http://localhost:5173

DATABASE_URL=postgresql://username:password@localhost:5432/ai_code_review_db

# Generate a unique value for every deployment. Never commit the real key.
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_EXPIRE_MINUTES=15
PASSWORD_RESET_EMAIL_PROVIDER=disabled
PASSWORD_RESET_FROM_EMAIL=
RESEND_API_KEY=
PASSWORD_RESET_RATE_LIMIT_EMAIL=5
PASSWORD_RESET_RATE_LIMIT_IP=10
PASSWORD_RESET_RATE_LIMIT_WINDOW_MINUTES=15

# AI provider: auto prefers Hugging Face when HF_TOKEN is configured.
AI_PROVIDER=auto

# Recommended free-tier provider. Create a fine-grained token with
# "Make calls to Inference Providers" permission.
HF_TOKEN=
HUGGINGFACE_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct:cheapest
HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1

# Optional paid fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
